IO_LOC "encoder2_b" C19;
IO_PORT "encoder2_b" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// TB6612 STBY is hardwired high on PCB. Coast STOP is IN1=IN2=0,PWM=1.
// Pull settings are not a substitute for a hardware default-disable circuit.
IO_LOC "motor_ain1" C15;
IO_PORT "motor_ain1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "motor_ain2" C14;
IO_PORT "motor_ain2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
