// 2026-10-08 expansion PCB, verified against .tel and physical P7 (60K board).
// Shared IMU/TOF SCL/SDA: no expansion-board pull-ups; IMU module has 4.7k.
// Keep FPGA weak pull-ups OFF. TOF module pull-up values/voltage remain unknown.
IO_LOC "sensor_scl" A13;
IO_PORT "sensor_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "sensor_sda" A14;
IO_PORT "sensor_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// P7 9=TRIG, 10=ECHO. No 5 V logic may be connected directly to these GPIO.
IO_LOC "ultrasonic_trig" E13;
IO_PORT "ultrasonic_trig" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "ultrasonic_echo" E14;
IO_PORT "ultrasonic_echo" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7 14=FPGA_TX -> HC-06 RX, P7 13=FPGA_RX <- HC-06 TX (3.3 V UART).
IO_LOC "bluetooth_tx" B13;
IO_PORT "bluetooth_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "bluetooth_rx" C13;
IO_PORT "bluetooth_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// P7 23/26 = encoder1 A/B, 25/28 = encoder2 A/B; inputs MUST be 3.3V compatible.
IO_LOC "encoder1_a" E16;
IO_PORT "encoder1_a" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "encoder1_b" B18;
