// LCD/LED pins: working lcd1024_v2 project; camera/DDR: chapter 45.
// Ethernet TX/MDIO: chapter 59; RX pins: chapter 56/58. Target GW5AT-60B.
// R3: S0 resets the whole design; S4 toggles the Gaussian filter.
// Touch from ACG720-138&60K schematic p1/p11. SDA is T20, NEVER W21.
IO_LOC "TP_rst_n" Y21;
IO_PORT "TP_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "TP_sda" T20;
IO_PORT "TP_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "TP_scl" T21;
IO_PORT "TP_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "TP_int" P20;
IO_PORT "TP_int" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
