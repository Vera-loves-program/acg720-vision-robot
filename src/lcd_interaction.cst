IO_LOC "laser_shut[3]" A19;
IO_PORT "laser_shut[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
// Each BQ bus already has two board 4.7k pull-ups to SYSTEM 3V3; parked at Z.
IO_LOC "bq_a_scl" F13;
IO_PORT "bq_a_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "bq_a_sda" F14;
IO_PORT "bq_a_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "bq_b_scl" D14;
IO_PORT "bq_b_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "bq_b_sda" D15;
IO_PORT "bq_b_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// SERVO0=P7-27 (upper), SERVO1=P7-24 (base): calibrated 50 Hz pulse outputs.
// Stepper signals remain held LOW. No pin location has changed.
IO_LOC "servo_0" C18;
IO_PORT "servo_0" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "servo_1" D16;
IO_PORT "servo_1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "step_0" F16;
IO_PORT "step_0" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "dir_0" C20;
IO_PORT "dir_0" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "step_1" D20;
IO_PORT "step_1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "dir_1" D19;
IO_PORT "dir_1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
// C1: P7-38/PIN38=E18 FPGA TX -> C1 RX; P7-40/PIN40=F20 FPGA RX <- C1 TX.
// 5V is sensor power, UART is 3.3V. Keep the original Bluetooth UART separate.
IO_LOC "lidar_tx" E18;
IO_PORT "lidar_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "lidar_rx" F20;
IO_PORT "lidar_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// P7-11/12/29/30 are power/ground; P7-32 NC and spare35/37/39 unused.

// Onboard BM8563T/24LC64 I2C bus: schematic and 60K pin table verified.
// R27/R28 are onboard 4.7k pull-ups to 3.3 V; independent of P7 sensor bus.
IO_LOC "IIC_scl" M13;
IO_PORT "IIC_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "IIC_sda" M16;
IO_PORT "IIC_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// Cascaded 74HC595, board vendor chapter 13/34 pinout (not external P7).
IO_LOC "SEG7_DIO" M18;
IO_PORT "SEG7_DIO" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "SEG7_RCLK" C2;
IO_PORT "SEG7_RCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "SEG7_SCLK" F4;
IO_PORT "SEG7_SCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
