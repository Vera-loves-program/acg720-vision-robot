// ACG720 schematic: FPC35=TP_RST, 36=TP_SDA, 38=TP_SCL, 39=TP_INT.
// FPC37 is unused. TP_RST is NOT the LCD RESET signal on FPC40.

IO_LOC "button4_n" B21;
IO_PORT "button4_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

