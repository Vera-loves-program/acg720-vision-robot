# Gowin generated outputs, often hundreds of MB and reproducible from source.
impl/**
!impl/vision_robot_process_config.json
!impl/vision_robot_netfix_process_config.json
!impl/vision_robot_ui_process_config.json
*.gprj.user
*.fs
*.bin
*.binx
*.db

# Python/VS Code local state.
__pycache__/
*.py[cod]
.venv/
.vscode/

# Camera photos / personal datasets are shared separately, never in source Git.
dataset/
datasets/
captures/
diagnostics/
*.probe.json

# Locally prepared private model artifacts are delivered in the client ZIP.
models/dog_plush/*.pt
models/dog_plush/*.onnx
models/dog_plush/*.onnx.data
models/face_yunet/*.onnx

# Local investigations, archives, browser profiles and handoff notes.
/tmp/
/archive/
/交接PROMPT_*.md

# Share release instructions/record; generate binary deliverables locally.
/output/*
!/output/releases/
/output/releases/*
!/output/releases/README.md
!/output/releases/records/
/output/releases/records/*
!/output/releases/records/vision_robot_core_r7_2136.json

# Measured per-car configuration and environment secrets.
/config/gimbal.json
/config/visual_task.json
.env
.env.*
!.env.example
id_rsa
id_ed25519
*.pem
*.key
